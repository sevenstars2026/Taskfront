        "type": "string"
      },
      "title": "Deliverables",
      "type": "array"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "examples": {
      "items": {
        "type": "string"
      },
      "title": "Examples",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "negative_examples": {
      "items": {
        "type": "string"
      },
      "title": "Negative Examples",
      "type": "array"
    },
    "optional_inputs": {
