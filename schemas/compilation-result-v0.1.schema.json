{
  "$defs": {
    "CandidateIntent": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "capability_version": {
          "title": "Capability Version",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/SourcedValue"
          },
          "title": "Inputs",
          "type": "object"
        },
        "match_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Match Reasons",
          "type": "array"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "unresolved_terms": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved Terms",
          "type": "array"
        }
      },
      "required": [
        "capability_id",
        "capability_version",
        "score",
        "match_reasons",
        "inputs"
      ],
      "title": "CandidateIntent",
      "type": "object"
    },
    "ClarificationQuestion": {
      "additionalProperties": false,
      "properties": {
        "answer_type": {
          "enum": [
            "text",
            "single_choice",
            "multi_choice",
            "boolean",
            "number"
          ],
          "title": "Answer Type",
          "type": "string"
        },
        "choices": {
          "default": [],
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Choices",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "priority": {
          "title": "Priority",
          "type": "number"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "targets": {
          "items": {
            "type": "string"
          },
          "title": "Targets",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "targets",
        "answer_type",
        "priority",
        "reason"
      ],
      "title": "ClarificationQuestion",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "contract_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contract Id"
        },
        "field_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Path"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "DispatchReadyIntent": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "capability_version": {
          "title": "Capability Version",
          "type": "string"
        },
        "compiled_at": {
          "format": "date-time",
          "title": "Compiled At",
          "type": "string"
        },
        "deliverables": {
          "items": {
            "type": "string"
          },
          "title": "Deliverables",
          "type": "array"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/SourcedValue"
          },
          "title": "Inputs",
          "type": "object"
        },
        "intent_id": {
          "title": "Intent Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "intent_id",
        "capability_id",
        "capability_version",
        "inputs",
        "deliverables",
        "compiled_at"
      ],
      "title": "DispatchReadyIntent",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "candidate_values": {
          "default": [],
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Candidate Values",
          "type": "array"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "field_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Field Path"
        },
        "kind": {
          "enum": [
            "missing",
            "ambiguous",
            "conflicting",
            "unverifiable",
            "unsupported",
            "defaultable"
          ],
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "suggested_resolution": {
          "enum": [
            "ask_user",
            "use_context",
            "apply_default",
            "choose_candidate",
            "reject"
          ],
          "title": "Suggested Resolution",
          "type": "string"
        }
      },
      "required": [
        "code",
        "kind",
        "field_path",
        "message",
        "blocking",
        "suggested_resolution"
      ],
      "title": "Gap",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "SourcedValue": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "source": {
          "enum": [
            "user",
            "application_context",
            "clarification_answer",
            "explicit_default",
            "model_inference"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "value",
        "source"
      ],
      "title": "SourcedValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CandidateIntent"
      },
      "title": "Candidates",
      "type": "array"
    },
    "diagnostics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "gaps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Gap"
      },
      "title": "Gaps",
      "type": "array"
    },
    "intent": {
      "anyOf": [
        {
          "$ref": "#/$defs/DispatchReadyIntent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "questions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ClarificationQuestion"
      },
      "title": "Questions",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateIntent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "enum": [
        "ready",
        "needs_clarification",
        "ambiguous",
        "conflicting",
        "unsupported",
        "invalid_contract"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status"
  ],
  "title": "CompilationResult",
  "type": "object"
}
